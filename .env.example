# ===== 基础 =====
# 数据库（本地用 SQLite；上线可换 Postgres，只改 provider 和 URL）
DATABASE_URL="file:./dev.db"

# ===== LLM =====
# provider: "openai" | "anthropic" | "ark"(豆包/火山方舟)
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
LLM_MODEL="gpt-4o-mini"

# 豆包（火山方舟 Ark）：把 LLM_PROVIDER 设为 ark，并填下面两项
# ARK_API_KEY 在火山方舟控制台获取；LLM_MODEL 填接入点 ID（ep-xxx）或模型名（如 doubao-pro-32k）
ARK_API_KEY=""
# LLM_MODEL="ep-xxxxxxxx"  # 用豆包时改这里

# ===== Stripe 支付 =====
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# 两个测试价格（月付）：基础版 / 专业版
STRIPE_PRICE_STARTER="price_xxx"
STRIPE_PRICE_PRO="price_yyy"

# ===== 应用 =====
APP_URL="http://localhost:3000"
